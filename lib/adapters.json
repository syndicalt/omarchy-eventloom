{
  "adapters": [
    {
      "agent": "omp",
      "method": "extension",
      "agent_home": "~/.omp/agent",
      "hook_path": "~/.omp/agent/extensions/eventloom.ts"
    },
    {
      "agent": "claude",
      "method": "claude-hooks",
      "agent_home": "~/.claude",
      "hook_path": "~/.claude/hooks/eventloom-hook.sh"
    }
  ]
}
