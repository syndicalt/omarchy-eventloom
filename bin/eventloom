#!/bin/sh
# eventloom launcher — bun and node both load the pinned runtime installed
# next to the shim. Neither falls through to a global cache.
set -e

LIB_DIR="$HOME/.local/lib/eventloom"

if [ ! -d "$LIB_DIR/node_modules/@eventloom/runtime" ]; then
  echo "eventloom: runtime not installed; run install.sh" >&2
  exit 1
fi

if command -v bun >/dev/null 2>&1; then
  exec bun "$LIB_DIR/eventloom.mjs" "$@"
fi

if command -v node >/dev/null 2>&1; then
  exec node "$LIB_DIR/eventloom.mjs" "$@"
fi

echo "eventloom: requires bun or node (neither found)" >&2
exit 1