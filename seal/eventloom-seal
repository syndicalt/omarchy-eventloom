#!/bin/sh
# eventloom-seal: the only thing that writes a seal file.
#
# Installed by seal/setup.sh as /usr/local/libexec/eventloom-seal, owned by
# root, and run through sudo as the user eventloom-seal. The log's owner, and
# so any agent running as them, can ask it to append a record and cannot
# write the file themselves. It never reads the log: it records what it is
# told, in order, with its own clock, and `eventloom verify` compares.
#
# It runs nothing from a home directory and trusts nothing the caller sets
# except the request itself, which is matched against strict patterns.
#
#   eventloom-seal head <YYYY-MM-DD> <position> <sha256:hex>
#   eventloom-seal ack  <YYYY-MM-DD> <position> purged|recovered
#   eventloom-seal version
#
# Exit: 0 written, 2 refused request, 3 not set up, 4 would move backwards.
set -eu
PATH=/usr/bin:/bin
export PATH
umask 027

FORMAT=1
SEAL_DIR=/var/lib/eventloom-seal

refuse() { echo "eventloom-seal: $2" >&2; exit "$1"; }
# One line, all of it: grep alone would accept a request whose first line
# matched and whose second was a forged record.
matches() {
  case "$1" in *"
"*) return 1 ;; esac
  printf '%s\n' "$1" | grep -Eqx "$2"
}

[ "${1:-}" = version ] && { echo "$FORMAT"; exit 0; }
[ "$#" -eq 4 ] || refuse 2 "usage: eventloom-seal head|ack <day> <position> <value>"
kind="$1" day="$2" position="$3" value="$4"

# sudo sets SUDO_UID itself; the caller cannot choose whose file is written.
uid="${SUDO_UID:-$(id -u)}"
matches "$uid" '[0-9]{1,10}' || refuse 2 "cannot tell who is asking"
matches "$day" '[0-9]{4}-[0-9]{2}-[0-9]{2}' || refuse 2 "not a day: $day"
case "$kind" in
  head)
    matches "$position" '[1-9][0-9]{0,8}' || refuse 2 "not a position: $position"
    matches "$value" 'sha256:[0-9a-f]{64}' || refuse 2 "not a hash"
    ;;
  ack)
    matches "$position" '(0|[1-9][0-9]{0,8})' || refuse 2 "not a position: $position"
    matches "$value" '(purged|recovered)' || refuse 2 "an ack is purged or recovered"
    ;;
  *) refuse 2 "unknown record kind: $kind" ;;
esac

file="$SEAL_DIR/$uid.evtseal"
[ -f "$file" ] || refuse 3 "sealed mode is not set up for uid $uid"

exec 9>>"$file"
flock -x 9

# Where the log last stood: the newest head, cut back by any ack for the same
# day that came after it. Read from the end, so the cost does not grow with
# the file.
last="$(tac "$file" | awk '
  $3 == "ack" { acked[$4] = ($4 in acked) ? acked[$4] : $5 }
  $3 == "head" { print $4, (($4 in acked) ? acked[$4] : $5); exit }
')"
if [ "$kind" = head ] && [ -n "$last" ]; then
  last_day="${last% *}" last_position="${last#* }"
  if [ "$day" \< "$last_day" ] || { [ "$day" = "$last_day" ] && [ "$position" -le "$last_position" ]; }; then
    refuse 4 "the log stood at $last_day $last_position; $day $position is not after it"
  fi
fi

previous="$(tail -n 1 "$file")"
case "$previous" in
  "eventloom-seal "*) sequence=1 link="$(printf '%s\n' "$previous" | sha256sum | cut -d' ' -f1)" ;;
  *) sequence=$(( ${previous%% *} + 1 )) link="${previous##* sha256:}" ;;
esac
body="$sequence $(date -u +%Y-%m-%dT%H:%M:%SZ) $kind $day $position $value"
printf '%s sha256:%s\n' "$body" "$(printf '%s %s\n' "$link" "$body" | sha256sum | cut -d' ' -f1)" >&9
echo "$sequence"
